{
  "schema": 1,
  "id": "pmw3610-report-interval",
  "enabled": false,
  "title": "Align the PMW3610 minimum report interval",
  "description": "Example only: choose and verify the desired value before enabling.",
  "repositories": ["mdk", "mrm"],
  "steps": [
    {
      "id": "report-interval",
      "repositories": ["mdk", "mrm"],
      "paths": ["snippets/Slot*_TB/**/*.conf", "snippets/Slot*_TB/*.conf"],
      "operation": "literal_replace",
      "find": "CONFIG_PMW3610_REPORT_INTERVAL_MIN=14",
      "replace": "CONFIG_PMW3610_REPORT_INTERVAL_MIN=16",
      "expect": {
        "mdk": { "min": 1, "max": 3 },
        "mrm": { "min": 1, "max": 3 }
      }
    }
  ]
}
